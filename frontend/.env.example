# Backend API address. Leave empty for local development (default http://localhost:8000)
#
# Note: NEXT_PUBLIC_* values are written into the bundle at `npm run build` time,
# not read at runtime. If you change this value you must rebuild; a restart has no effect.
NEXT_PUBLIC_API_BASE=
# Production example: NEXT_PUBLIC_API_BASE=https://metabosquad.example.org
