# If you want LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY="your_api_key"
# LANGSMITH_PROJECT="your_project_name"

# Required
OPENAI_API_KEY=
PG_URL = 
TEST_PG_URL = 
EMAIL =

# NCBI_KEY must either have a value or stay commented out entirely; **do not leave it empty**.
# os.getenv reads an empty string as '' (not None), Biopython then puts api_key= into
# the Entrez URL, and NCBI returns HTTP 400 -> literature search always returns 0 papers, with no obvious error.
# Register for a free key (raises the rate limit from 3 req/s to 10 req/s):
#   https://www.ncbi.nlm.nih.gov/account/settings/
# NCBI_KEY =

# Frontend origins, comma-separated. If unset, only localhost is allowed by default
CORS_ORIGINS = http://localhost:3000
